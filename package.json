{
  "name": "figma-local-bridge",
  "version": "0.14.2-local.5",
  "private": true,
  "description": "Local-only MCP bridge for controlling the Figma Design file open in Figma Desktop.",
  "homepage": "https://github.com/support491/figma-local-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/support491/figma-local-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/support491/figma-local-bridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild server.mjs --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
    "check": "node --check server.mjs && node --check plugin/code.js && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "service": "node scripts/service.mjs",
    "package:desktop": "node scripts/build-mcpb.mjs",
    "check:desktop": "node --test test/desktop-extension.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fflate": "0.8.3"
  }
}
